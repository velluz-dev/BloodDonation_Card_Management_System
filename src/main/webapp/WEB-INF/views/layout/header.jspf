<%--
  Common page opening: document head, navigation and flash messages.

  Every dynamic value below goes through <c:out> or ${fn:escapeXml(...)}.
  That is the XSS control named in the non-functional requirements - a donor
  name containing markup is rendered as text, never as HTML.

  Page directives and taglibs live in taglibs.jspf, which every view includes
  before this one - see the note there for why the ordering matters.
--%>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><c:out value="${pageTitle}" default="Blood Donation Card Management System" /> &middot; BDCMS</title>
  <link rel="stylesheet" href="${ctx}/assets/vendor/bootstrap/bootstrap.min.css">
  <link rel="stylesheet" href="${ctx}/assets/css/bdcms.css">
  <link rel="icon" href="${ctx}/assets/img/favicon.svg" type="image/svg+xml">
</head>
<body class="bdcms" data-ctx="${ctx}">

<c:if test="${not empty currentUser}">
  <nav class="bdcms-navbar">
    <a class="navbar-brand" href="${ctx}/app/dashboard">
      <span class="bdcms-drop" aria-hidden="true"></span>
      <span>BDCMS</span>
    </a>

    <button class="navbar-toggler d-lg-none border-0 p-0 ms-auto me-2" type="button"
            data-bs-toggle="collapse" data-bs-target="#mainNav"
            aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse d-lg-flex" id="mainNav">
      <ul class="navbar-nav me-auto mb-0">
        <li class="nav-item">
          <a class="nav-link ${nav eq 'dashboard' ? 'active' : ''}" href="${ctx}/app/dashboard">Dashboard</a>
        </li>
        <li class="nav-item">
          <a class="nav-link ${nav eq 'donors' ? 'active' : ''}" href="${ctx}/app/donors">Donors</a>
        </li>
        <%-- The mockup shows a "Cards" tab. There is no cards index in this
             system: a card is always reached through the donor who holds it,
             which is the same rule the data model follows. Rather than link to
             a page that does not exist, the tab is omitted. --%>
        <li class="nav-item">
          <a class="nav-link ${nav eq 'verify' ? 'active' : ''}" href="${ctx}/app/verify">Verify &amp; record</a>
        </li>
        <c:if test="${currentUser.admin}">
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle ${nav eq 'admin' ? 'active' : ''}" href="#"
               role="button" data-bs-toggle="dropdown" aria-expanded="false">Reports</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="${ctx}/app/reports">Reports &amp; PDF export</a></li>
              <li><a class="dropdown-item" href="${ctx}/app/admin/verification-log">Verification audit log</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="${ctx}/app/admin/users">Staff accounts</a></li>
              <li><a class="dropdown-item" href="${ctx}/app/admin/settings">System settings</a></li>
            </ul>
          </li>
        </c:if>
      </ul>

      <div class="d-flex align-items-center gap-3">
        <span class="bdcms-navbar-user"><c:out value="${currentUser.fullName}" /></span>
        <span class="bdcms-role ${currentUser.admin ? 'bdcms-role-admin' : ''}">
          <c:out value="${currentUser.role}" />
        </span>
        <form method="post" action="${ctx}/logout" class="m-0">
          <input type="hidden" name="_csrf" value="${csrfToken}">
          <button type="submit" class="btn btn-sm btn-quiet"
                  style="border-color:rgba(239,235,227,.28);color:rgba(239,235,227,.75)">Sign out</button>
        </form>
      </div>
    </div>
  </nav>
</c:if>

<main class="container-fluid py-4 px-lg-4">

  <c:if test="${not empty flashSuccess}">
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <c:out value="${flashSuccess}" />
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  </c:if>
  <c:if test="${not empty flashError}">
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <c:out value="${flashError}" />
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  </c:if>
  <c:if test="${not empty errorMessage}">
    <div class="alert alert-danger" role="alert"><c:out value="${errorMessage}" /></div>
  </c:if>
  <c:if test="${not empty infoMessage}">
    <div class="alert alert-info" role="alert"><c:out value="${infoMessage}" /></div>
  </c:if>
