<%--
  Icon sprite.

  Inline SVG symbols rather than an icon font or a CDN sprite: nothing to
  download, nothing to fail offline, and each icon inherits currentColor so it
  takes the colour of the text beside it.

  Use with:  <svg class="ic"><use href="#i-users"/></svg>

  Stroke-based at 24x24 on a 1.6 stroke, which is what keeps them looking like
  one family rather than a pile of clip art.
--%>
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <g id="ic-base" fill="none" stroke="currentColor" stroke-width="1.6"
       stroke-linecap="round" stroke-linejoin="round"></g>
  </defs>

  <symbol id="i-drop" viewBox="0 0 24 24">
    <path d="M12 3s6 6.4 6 10a6 6 0 0 1-12 0c0-3.6 6-10 6-10z" fill="currentColor" stroke="none"/>
  </symbol>

  <symbol id="i-dashboard" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="3" width="7" height="8" rx="1.6"/>
    <rect x="14" y="3" width="7" height="5" rx="1.6"/>
    <rect x="14" y="11" width="7" height="10" rx="1.6"/>
    <rect x="3" y="14" width="7" height="7" rx="1.6"/>
  </symbol>

  <symbol id="i-users" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="9" cy="8" r="3.2"/>
    <path d="M3.5 20a5.5 5.5 0 0 1 11 0"/>
    <path d="M16 5.2a3.2 3.2 0 0 1 0 5.9"/>
    <path d="M17.5 14.4A5.5 5.5 0 0 1 20.5 20"/>
  </symbol>

  <symbol id="i-verify" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3.5" y="3.5" width="17" height="17" rx="3.5"/>
    <path d="M8 12.3l2.8 2.8L16.2 9.5"/>
  </symbol>

  <symbol id="i-report" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 2.8h7.5L19 8.4V21a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3.8a1 1 0 0 1 1-1z"/>
    <path d="M13.2 3v5.4H19"/>
    <path d="M8.5 13h7M8.5 17h4.5"/>
  </symbol>

  <symbol id="i-card" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <rect x="2.5" y="5" width="19" height="14" rx="2.6"/>
    <path d="M2.5 9.6h19"/>
    <path d="M6 14.6h3.5"/>
  </symbol>

  <symbol id="i-shield" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 2.8l7.2 3v5.6c0 4.4-3 8.2-7.2 9.8-4.2-1.6-7.2-5.4-7.2-9.8V5.8z"/>
    <path d="M9.2 12.2l2 2 3.6-3.8"/>
  </symbol>

  <symbol id="i-trend" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M3 16.5l5.5-5.5 3.5 3.5L21 5.5"/>
    <path d="M15.5 5.5H21v5.5"/>
  </symbol>

  <symbol id="i-calendar" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3.2" y="5" width="17.6" height="16" rx="2.6"/>
    <path d="M3.2 10h17.6M8 3v4M16 3v4"/>
  </symbol>

  <symbol id="i-user" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="8.4" r="3.6"/>
    <path d="M4.8 20a7.2 7.2 0 0 1 14.4 0"/>
  </symbol>

  <symbol id="i-signout" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M14.5 3.5H18a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2h-3.5"/>
    <path d="M9.5 16l-4-4 4-4M5.5 12H15"/>
  </symbol>

  <symbol id="i-gear" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="3.1"/>
    <path d="M19.2 14.6a1.6 1.6 0 0 0 .32 1.76l.06.06a1.9 1.9 0 1 1-2.7 2.7l-.06-.06a1.6 1.6 0 0 0-2.72 1.14v.17a1.9 1.9 0 1 1-3.8 0v-.09a1.6 1.6 0 0 0-2.8-1.07l-.06.06a1.9 1.9 0 1 1-2.7-2.7l.06-.06a1.6 1.6 0 0 0-1.14-2.72h-.17a1.9 1.9 0 1 1 0-3.8h.09A1.6 1.6 0 0 0 5.5 7.26l-.06-.06a1.9 1.9 0 1 1 2.7-2.7l.06.06a1.6 1.6 0 0 0 2.72-1.14v-.17a1.9 1.9 0 1 1 3.8 0v.09a1.6 1.6 0 0 0 2.72 1.14l.06-.06a1.9 1.9 0 1 1 2.7 2.7l-.06.06a1.6 1.6 0 0 0 1.14 2.72h.17a1.9 1.9 0 1 1 0 3.8h-.09a1.6 1.6 0 0 0-1.46.9z"/>
  </symbol>

  <symbol id="i-clock" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="8.6"/>
    <path d="M12 7.2V12l3.2 1.9"/>
  </symbol>

  <symbol id="i-camera" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M3.4 8.4A2.4 2.4 0 0 1 5.8 6h1.9l1.2-2h6.2l1.2 2h1.9a2.4 2.4 0 0 1 2.4 2.4v8.2A2.4 2.4 0 0 1 18.2 19H5.8a2.4 2.4 0 0 1-2.4-2.4z"/>
    <circle cx="12" cy="12.4" r="3.4"/>
  </symbol>

  <symbol id="i-search" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="10.8" cy="10.8" r="6.6"/>
    <path d="M15.6 15.6L20.5 20.5"/>
  </symbol>

  <symbol id="i-scan" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M3.5 8.5v-3a2 2 0 0 1 2-2h3M15.5 3.5h3a2 2 0 0 1 2 2v3M20.5 15.5v3a2 2 0 0 1-2 2h-3M8.5 20.5h-3a2 2 0 0 1-2-2v-3"/>
    <path d="M7.5 12h9"/>
  </symbol>

  <symbol id="i-chev-right" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M9.5 5.5l6.5 6.5-6.5 6.5"/>
  </symbol>

  <symbol id="i-chev-down" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M5.5 9l6.5 6.5L18.5 9"/>
  </symbol>

  <symbol id="i-arrow-right" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4.5 12h15M13.5 6l6 6-6 6"/>
  </symbol>

  <symbol id="i-alert-file" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 2.8h7.5L19 8.4V21a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3.8a1 1 0 0 1 1-1z"/>
    <path d="M13.2 3v5.4H19"/>
    <path d="M12 12v3.4M12 18.2v.01"/>
  </symbol>

  <symbol id="i-help" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="8.8"/>
    <path d="M9.6 9.4a2.5 2.5 0 1 1 3.4 2.3c-.7.3-1 .9-1 1.6v.4"/>
    <path d="M12 17.4v.01"/>
  </symbol>
</svg>
